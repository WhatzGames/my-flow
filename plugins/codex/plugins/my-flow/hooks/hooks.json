{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/target_workspace.py\" startup"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/target_workspace.py\" refresh"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/install_git_hooks.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/target_workspace.py\" hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/target_workspace.py\" hook"
          }
        ]
      },
      {
        "matcher": "Bash|Shell|exec_command|functions.exec_command|mcp__github__.*|github.*|mcp__git__.*|git.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/enforce_ssh_host.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/require_github_push_approval.py\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/allow_worktree_access.py\""
          }
        ]
      }
    ]
  }
}
